# LLM provider priority (comma-separated): ollama, groq, openrouter
# Falls through to next if one fails
LLM_PROVIDER=groq,openrouter,ollama

# Ollama (self-hosted, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# Groq (free tier, fast)
GROQ_API_KEY=gsk_
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free tier, many models)
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_MODEL=qwen/qwen3.6-plus-preview:free

# ═══ ACCESS ═══
# Vaults are opened with a long random access key — no usernames, no passwords.
# Create one:  python3 scripts/users.py add "Name"
#     Docker:  docker compose exec cooker python3 scripts/users.py add "Name"
# Until the first key exists the app runs as a single open vault.

# Let anyone who reaches the login page mint their own vault key (default: off)
ALLOW_SIGNUP=

# Session cookie name. Changing it signs every device out everywhere.
COOKIE=mv_key

# Origins allowed to call the API with credentials (comma-separated). Empty = same-origin only.
CORS_ORIGINS=

# Set to 1 only when a reverse proxy you control sets X-Forwarded-For,
# otherwise the login throttle can be bypassed with a spoofed header.
TRUST_PROXY=

# How long a signed-in device stays signed in, in seconds (default 31536000 = 1 year)
SESSION_MAX_AGE=31536000

# Legacy: one shared PIN for the whole install. Ignored once access keys exist.
AUTH_PIN=

# Optional: move the databases. The library is shareable; the vault is not.
# DB_PATH=./data/recipes.db
# VAULT_DB_PATH=./data/vault.db
