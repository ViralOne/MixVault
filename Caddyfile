# Caddyfile for MixVault Cooker
# Replace 'cooker.yourdomain.com' with your actual domain
# For Tailscale: use your tailnet hostname like 'cooker.tail1234.ts.net'

cooker.yourdomain.com {
    # Caddy forwards X-Forwarded-Proto, which is how the app knows to mark the
    # session cookie Secure. Set TRUST_PROXY=1 in .env so it believes it.
    reverse_proxy cooker:8080

    header {
        # The app already sends CSP, nosniff, X-Frame-Options, Referrer-Policy and
        # Permissions-Policy — repeating them here would silently override them
        # with something weaker. HSTS is Caddy's to add, since it terminates TLS.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Gzip
    encode gzip

    # Logging
    log {
        output file /data/access.log
        format console
    }
}

# If using without a domain (local IP only), use:
# :443 {
#     tls internal
#     reverse_proxy cooker:8080
# }
